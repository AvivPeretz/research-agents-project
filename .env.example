# ============================================================
# LLM PROVIDERS
# ============================================================

# [REQUIRED] Primary LLM — Free tier at console.groq.com
GROQ_API_KEY=gsk_...

# [OPTIONAL] Fallback LLM #1 — Free tier at aistudio.google.com
# Also activates Gemma 4 (Fallback #2) automatically — Gemma 4 reuses this same
# key/client, so no separate Gemma-specific variable is needed.
GEMINI_API_KEY=AIza...

# [OPTIONAL] Fallback LLM #3 — Free tier at build.nvidia.com (NIM endpoint)
NVIDIA_NIM_API_KEY=nvapi-...

# [OPTIONAL] Fallback LLM #4 (last resort) — Paid, at platform.openai.com
OPENAI_API_KEY=sk-...


# ============================================================
# EMAIL — GMAIL RELAY (Sender Account)
# ============================================================
# This is a Gmail account used ONLY for sending notification emails.
# It does NOT need to be your university email.
# Recommendation: create a dedicated dummy Gmail account for this.

NOTIFICATION_SENDER_EMAIL=your-relay@gmail.com
NOTIFICATION_SENDER_PASSWORD=xxxx xxxx xxxx xxxx
# ↑ This is a Gmail App Password (16 chars with spaces), NOT your Gmail login password.
# To generate one: Google Account → Security → 2-Step Verification → App Passwords


# ============================================================
# OVERLEAF / UNIVERSITY ACCOUNT (Receiver Account)
# ============================================================
# This is your university email connected to Overleaf.
# Used for: logging into Overleaf and receiving Stanford review tokens.

OVERLEAF_EMAIL=your.name@university.edu
OVERLEAF_PASSWORD=your-overleaf-password


# ============================================================
# NOTIFICATIONS — RECEIVER OVERRIDE
# ============================================================
# [OPTIONAL] The researcher email that RECEIVES notifications. Defaults to
# OVERLEAF_EMAIL if not set — only needed if notifications should go somewhere
# other than the Overleaf login account itself.
# RESEARCHER_EMAIL=researcher@university.edu


# ============================================================
# LITERATURE SEARCH — ALL OPTIONAL (fallback chain: Semantic Scholar → SerpAPI → scholarly)
# ============================================================
# [OPTIONAL] Semantic Scholar — free, higher rate limit with a key
# SEMANTIC_SCHOLAR_API_KEY=...

# [OPTIONAL] OpenAlex enrichment — free, higher rate limit with a key
# OPENALEX_API_KEY=...

# [OPTIONAL] SerpAPI — Google Scholar fallback, 250 free searches/month at serpapi.com
# SERPAPI_API_KEY=...


# ============================================================
# ADVANCED / TUNING — ALL OPTIONAL (defaults shown are what config.py uses if unset)
# ============================================================
# Every variable below has a working default in config.py — you do not need to set
# any of these to run the system. Uncomment only to override a specific default.

# Model used for cheap/fast extraction calls (keyword generation, relevance
# filtering) instead of the main synthesis model. Defaults to openai/gpt-oss-20b
# (a smaller/faster Groq sibling of the primary openai/gpt-oss-120b) if unset.
# LLM_EXTRACTION_MODEL_NAME=...

# Seconds an LLM provider is skipped after a rate-limit error, shared across every
# agent in the process. Default: 90.
# LLM_RATE_LIMIT_COOLDOWN_SECONDS=90

# Retry attempts for a failed outbound email send. Default: 3.
# EMAIL_MAX_RETRIES=3

# Whether Playwright browser automation (Overleaf, Stanford paperreview.ai) runs
# headless. Set to "false" only for local debugging with a visible browser window.
# Default: true.
# PLAYWRIGHT_HEADLESS=true

# Days a generated .md file (literature/progress/enhancement output) is kept before
# the garbage collector deletes it. Default: 30.
# GARBAGE_COLLECTION_TTL_DAYS=30

# Consecutive Stanford upload failures for ONE project tolerated before falling back
# to the internal LLM peer review. Default: 2.
# STANFORD_MAX_UPLOAD_RETRIES=2

# Consecutive Stanford upload failures across ANY projects in the same run before
# assuming Stanford itself is down and skipping further upload attempts this run.
# Default: 3.
# STANFORD_CONSECUTIVE_FAILURE_THRESHOLD=3

# Hours an agent_runs row can sit at STARTED with no SUCCESS/FAILURE before it's
# flagged as a stale/crashed run (see GarbageCollector's stale-run alert). Default: 2.0.
# STALE_RUN_THRESHOLD_HOURS=2.0

# ThreadPoolExecutor worker counts for per-project parallel processing.
# Default: 4 for both.
# PROGRESS_MAX_WORKERS=4
# LITERATURE_MAX_WORKERS=4