# ============================================================
# LLM PROVIDERS
# ============================================================

# [REQUIRED] Primary LLM — Free tier at console.groq.com
GROQ_API_KEY=gsk_...

# [OPTIONAL] Fallback LLM #1 — Free tier at aistudio.google.com
# Also activates Gemma 4 (Fallback #2) automatically — Gemma 4 reuses this same
# key/client, so no separate Gemma-specific variable is needed.
GEMINI_API_KEY=AIza...

# [OPTIONAL] Fallback LLM #3 — Free tier at build.nvidia.com (NIM endpoint)
NVIDIA_NIM_API_KEY=nvapi-...

# [OPTIONAL] Fallback LLM #4 (last resort) — Paid, at platform.openai.com
OPENAI_API_KEY=sk-...


# ============================================================
# EMAIL — GMAIL RELAY (Sender Account)
# ============================================================
# This is a Gmail account used ONLY for sending notification emails.
# It does NOT need to be your university email.
# Recommendation: create a dedicated dummy Gmail account for this.

NOTIFICATION_SENDER_EMAIL=your-relay@gmail.com
NOTIFICATION_SENDER_PASSWORD=xxxx xxxx xxxx xxxx
# ↑ This is a Gmail App Password (16 chars with spaces), NOT your Gmail login password.
# To generate one: Google Account → Security → 2-Step Verification → App Passwords


# ============================================================
# OVERLEAF / UNIVERSITY ACCOUNT (Receiver Account)
# ============================================================
# This is your university email connected to Overleaf.
# Used for: logging into Overleaf and receiving Stanford review tokens.

OVERLEAF_EMAIL=your.name@university.edu
OVERLEAF_PASSWORD=your-overleaf-password


# ============================================================
# NOTIFICATIONS — RECEIVER OVERRIDE
# ============================================================
# [OPTIONAL] The researcher email that RECEIVES notifications. Defaults to
# OVERLEAF_EMAIL if not set — only needed if notifications should go somewhere
# other than the Overleaf login account itself.
# RESEARCHER_EMAIL=researcher@university.edu


# ============================================================
# LITERATURE SEARCH — ALL OPTIONAL (fallback chain: Semantic Scholar → SerpAPI → scholarly)
# ============================================================
# [OPTIONAL] Semantic Scholar — free, higher rate limit with a key
# SEMANTIC_SCHOLAR_API_KEY=...

# [OPTIONAL] OpenAlex enrichment — free, higher rate limit with a key
# OPENALEX_API_KEY=...

# [OPTIONAL] SerpAPI — Google Scholar fallback, 250 free searches/month at serpapi.com
# SERPAPI_API_KEY=...